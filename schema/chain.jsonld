      "port": 8333,
      "p2pkhVersion": 0,
      "p2shVersion": 5,
      "bech32Hrp": "bc",
      "maxMoney": 2100000000000000,
      "initialSubsidy": 5000000000,
      "maxBlockWeight": 4000000,
