        },
        {
          "name": "OP_HASH160",
          "code": 169,
          "category": "crypto",
          "comment": "SHA-256 then RIPEMD-160 \u2014 the public-key and script hash used in addresses."
        },
        {
          "name": "OP_HASH256",
          "code": 170,
          "category": "crypto",
          "comment": "Double SHA-256 \u2014 the block and transaction hash function."
        },
        {
          "name": "OP_CODESEPARATOR",
