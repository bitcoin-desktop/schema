      ]
    },
    {
      "@id": "btc:ScriptType",
      "@type": "Enumeration",
      "module": "btc:script",
      "label": "ScriptType",
      "comment": "Standard output script templates. <n> in a template matches a data push of exactly n bytes; <a|b> matches either length. The addressEncoding rule derives the address from the matched data pushes (payload 'push:n' is the n-th data push) and the network's parameters (base58 version bytes, bech32 HRP).",
      "members": [
        {
          "name": "p2pk",
          "comment": "Pay to public key: the original output form, used by early coinbases including the genesis block. No address form exists.",
          "template": "<33|65> OP_CHECKSIG"
        },
        {
          "name": "p2pkh",
          "comment": "Pay to public key hash: the classic base58 '1\u2026' address.",
          "template": "OP_DUP OP_HASH160 <20> OP_EQUALVERIFY OP_CHECKSIG",
          "addressEncoding": {
            "encoding": "base58check",
            "versionParam": "p2pkhVersion",
            "payload": "push:0"
          }
        },
        {
          "name": "p2sh",
          "comment": "Pay to script hash (BIP 16): the spender reveals a redeem script matching the hash. Base58 '3\u2026' address.",
          "template": "OP_HASH160 <20> OP_EQUAL",
          "bip": 16,
          "addressEncoding": {
            "encoding": "base58check",
            "versionParam": "p2shVersion",
            "payload": "push:0"
          }
        },
        {
          "name": "p2wpkh",
          "comment": "Native segwit v0 pay to witness public key hash (BIP 141). Bech32 'bc1q\u2026' address.",
          "template": "OP_0 <20>",
          "bip": [
            141,
            173
          ],
          "addressEncoding": {
            "encoding": "bech32",
            "witnessVersion": 0,
            "payload": "push:0"
          }
        },
        {
          "name": "p2wsh",
          "comment": "Native segwit v0 pay to witness script hash (BIP 141). Bech32 'bc1q\u2026' address (longer).",
          "template": "OP_0 <32>",
          "bip": [
            141,
            173
          ],
          "addressEncoding": {
            "encoding": "bech32",
            "witnessVersion": 0,
            "payload": "push:0"
          }
        },
        {
          "name": "p2tr",
          "comment": "Taproot (BIP 341): pay to a tweaked x-only public key. Bech32m 'bc1p\u2026' address.",
          "template": "OP_1 <32>",
          "bip": [
            341,
            350
          ],
          "addressEncoding": {
            "encoding": "bech32m",
            "witnessVersion": 1,
            "payload": "push:0"
          }
        },
        {
          "name": "multisig",
          "comment": "Bare m-of-n multisig: OP_m <pubkey>\u2026 OP_n OP_CHECKMULTISIG. No address form.",
          "special": "multisig"
        },
        {
          "name": "nulldata",
          "comment": "OP_RETURN data carrier: provably unspendable, excluded from the UTXO set.",
          "special": "nulldata"
        },
        {
          "name": "witness-unknown",
          "comment": "A witness program with a version not yet assigned semantics (OP_2..OP_16 followed by a 2-40 byte push). Valid to send to; anyone-can-spend until a soft fork defines it.",
          "special": "witness-unknown",
          "bip": 141,
          "addressEncoding": {
            "encoding": "bech32m",
            "payload": "push:0"
          }
        },
        {
          "name": "nonstandard",
          "comment": "Any script matching no standard template. Consensus-valid but not relayed by default policy.",
          "special": "fallback"
        }
      ]
    },
    {
      "@id": "btc:SighashType",
      "@type": "Enumeration",
      "module": "btc:script",
      "label": "SighashType",
      "comment": "Signature hash modes controlling which parts of a transaction a signature commits to. ANYONECANPAY is a flag combinable with the base modes.",
      "members": [
        {
          "name": "SIGHASH_DEFAULT",
          "code": 0,
          "comment": "Taproot only (BIP 341): equivalent to SIGHASH_ALL but allows the shorter 64-byte signature.",
          "bip": 341
        },
        {
          "name": "SIGHASH_ALL",
          "code": 1,
          "comment": "Commit to all inputs and all outputs \u2014 the default and overwhelmingly most common mode."
        },
        {
          "name": "SIGHASH_NONE",
          "code": 2,
          "comment": "Commit to all inputs and no outputs."
        },
        {
          "name": "SIGHASH_SINGLE",
          "code": 3,
          "comment": "Commit to all inputs and only the output with the same index as the signed input."
        },
        {
          "name": "SIGHASH_ANYONECANPAY",
          "code": 128,
          "comment": "Flag: commit only to the signed input, allowing others to add inputs."
        }
      ]
    },
    {
      "@id": "btc:ScriptLimits",
      "@type": "ContextStruct",
      "module": "btc:script",
      "label": "ScriptLimits",
      "comment": "Consensus limits on script execution. Enforced by the interpreter; exceeding any of them fails the script.",
      "fields": [
        {
          "property": "btc:maxScriptSize",
          "label": "maxScriptSize",
          "valueType": "u32",
          "comment": "Maximum script length in bytes: 10,000."
        },
        {
