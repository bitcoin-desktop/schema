{
  "@context": "../context.jsonld",
  "@graph": [
    {
      "@id": "btc:script",
      "@type": "Module",
      "label": "script",
      "version": "0.0.7",
      "comment": "The Bitcoin script language surface: the opcode set, the standard output script templates with their address encodings, and signature hash types. Templates are declarative \u2014 the classifier matches them as data.",
      "layer": "consensus"
    },
    {
      "@id": "btc:Opcode",
      "@type": "Enumeration",
      "module": "btc:script",
      "label": "Opcode",
      "comment": "Every assigned script opcode. Bytes 0x01-0x4b are OP_PUSHBYTES_1..75 (push that many following bytes) and are modeled as a range rather than 75 members. Disabled opcodes make a transaction invalid if present in an executed script. Unassigned bytes above OP_CHECKSIGADD are invalid in legacy/segwit script and OP_SUCCESSx in tapscript (BIP 342).",
      "members": [
        {
          "name": "OP_0",
          "code": 0,
          "category": "constants",
          "comment": "Push an empty byte vector (numeric zero). Alias OP_FALSE."
        },
        {
          "name": "OP_PUSHDATA1",
          "code": 76,
          "category": "constants",
          "comment": "The next byte gives the number of bytes to push."
        },
        {
          "name": "OP_PUSHDATA2",
          "code": 77,
          "category": "constants",
          "comment": "The next two bytes (LE) give the number of bytes to push."
        },
        {
          "name": "OP_PUSHDATA4",
          "code": 78,
          "category": "constants",
          "comment": "The next four bytes (LE) give the number of bytes to push."
        },
        {
          "name": "OP_1NEGATE",
          "code": 79,
          "category": "constants",
          "comment": "Push the number -1."
        },
        {
          "name": "OP_RESERVED",
          "code": 80,
          "category": "reserved",
          "comment": "Reserved; transaction is invalid unless occurring in an unexecuted branch."
        },
        {
          "name": "OP_1",
          "code": 81,
          "category": "constants",
          "comment": "Push the number 1. Also the segwit/taproot witness version prefix."
        },
        {
          "name": "OP_2",
          "code": 82,
          "category": "constants",
          "comment": "Push the number 2."
        },
        {
          "name": "OP_3",
          "code": 83,
          "category": "constants",
          "comment": "Push the number 3."
        },
        {
          "name": "OP_4",
          "code": 84,
          "category": "constants",
          "comment": "Push the number 4."
        },
        {
          "name": "OP_5",
          "code": 85,
          "category": "constants",
          "comment": "Push the number 5."
        },
        {
          "name": "OP_6",
          "code": 86,
          "category": "constants",
          "comment": "Push the number 6."
        },
        {
          "name": "OP_7",
          "code": 87,
          "category": "constants",
          "comment": "Push the number 7."
        },
        {
          "name": "OP_8",
          "code": 88,
          "category": "constants",
          "comment": "Push the number 8."
        },
        {
          "name": "OP_9",
          "code": 89,
          "category": "constants",
          "comment": "Push the number 9."
        },
        {
          "name": "OP_10",
          "code": 90,
          "category": "constants",
          "comment": "Push the number 10."
        },
        {
          "name": "OP_11",
          "code": 91,
          "category": "constants",
          "comment": "Push the number 11."
        },
        {
          "name": "OP_12",
          "code": 92,
          "category": "constants",
          "comment": "Push the number 12."
        },
        {
          "name": "OP_13",
          "code": 93,
          "category": "constants",
          "comment": "Push the number 13."
        },
        {
          "name": "OP_14",
          "code": 94,
          "category": "constants",
          "comment": "Push the number 14."
        },
        {
          "name": "OP_15",
          "code": 95,
          "category": "constants",
          "comment": "Push the number 15."
        },
        {
          "name": "OP_16",
          "code": 96,
          "category": "constants",
          "comment": "Push the number 16."
        },
        {
          "name": "OP_NOP",
          "code": 97,
          "category": "flow",
          "comment": "Does nothing."
        },
        {
          "name": "OP_VER",
          "code": 98,
          "category": "reserved",
          "comment": "Reserved; invalid unless in an unexecuted branch."
        },
        {
          "name": "OP_IF",
          "code": 99,
          "category": "flow",
          "comment": "Execute the following statements if the top stack value is true (popped)."
        },
        {
          "name": "OP_NOTIF",
          "code": 100,
          "category": "flow",
          "comment": "Execute the following statements if the top stack value is false (popped)."
        },
        {
          "name": "OP_VERIF",
          "code": 101,
          "category": "reserved",
          "comment": "Reserved; transaction is invalid even in an unexecuted branch."
        },
        {
          "name": "OP_VERNOTIF",
          "code": 102,
          "category": "reserved",
          "comment": "Reserved; transaction is invalid even in an unexecuted branch."
        },
        {
          "name": "OP_ELSE",
          "code": 103,
          "category": "flow",
          "comment": "Execute if the preceding OP_IF/OP_NOTIF branch was not executed."
        },
        {
          "name": "OP_ENDIF",
          "code": 104,
          "category": "flow",
          "comment": "Ends an OP_IF/OP_NOTIF/OP_ELSE block."
        },
        {
          "name": "OP_VERIFY",
          "code": 105,
          "category": "flow",
          "comment": "Fail the script if the top stack value is not true; pops it."
        },
        {
          "name": "OP_RETURN",
          "code": 106,
          "category": "flow",
          "comment": "Fail the script immediately. Standard for provably-unspendable data-carrier outputs."
        },
        {
          "name": "OP_TOALTSTACK",
          "code": 107,
          "category": "stack",
          "comment": "Move the top item to the alt stack."
        },
        {
          "name": "OP_FROMALTSTACK",
          "code": 108,
          "category": "stack",
          "comment": "Move the top alt-stack item to the main stack."
        },
        {
          "name": "OP_2DROP",
          "code": 109,
          "category": "stack",
          "comment": "Drop the top two items."
        },
        {
          "name": "OP_2DUP",
          "code": 110,
          "category": "stack",
          "comment": "Duplicate the top two items."
        },
        {
          "name": "OP_3DUP",
          "code": 111,
          "category": "stack",
          "comment": "Duplicate the top three items."
        },
        {
          "name": "OP_2OVER",
          "code": 112,
          "category": "stack",
          "comment": "Copy the third and fourth items to the top."
        },
        {
          "name": "OP_2ROT",
          "code": 113,
          "category": "stack",
          "comment": "Move the fifth and sixth items to the top."
        },
        {
          "name": "OP_2SWAP",
          "code": 114,
          "category": "stack",
          "comment": "Swap the top two pairs of items."
        },
        {
          "name": "OP_IFDUP",
          "code": 115,
          "category": "stack",
          "comment": "Duplicate the top item if it is not zero."
        },
        {
          "name": "OP_DEPTH",
          "code": 116,
          "category": "stack",
          "comment": "Push the stack depth."
        },
        {
          "name": "OP_DROP",
          "code": 117,
          "category": "stack",
          "comment": "Drop the top item."
        },
        {
          "name": "OP_DUP",
          "code": 118,
          "category": "stack",
          "comment": "Duplicate the top item."
        },
        {
          "name": "OP_NIP",
          "code": 119,
          "category": "stack",
          "comment": "Remove the second item."
        },
        {
          "name": "OP_OVER",
          "code": 120,
          "category": "stack",
          "comment": "Copy the second item to the top."
        },
        {
          "name": "OP_PICK",
          "code": 121,
          "category": "stack",
          "comment": "Copy the item n back to the top (n popped)."
        },
        {
          "name": "OP_ROLL",
          "code": 122,
          "category": "stack",
          "comment": "Move the item n back to the top (n popped)."
        },
        {
          "name": "OP_ROT",
          "code": 123,
          "category": "stack",
          "comment": "Rotate the top three items."
        },
        {
          "name": "OP_SWAP",
          "code": 124,
          "category": "stack",
          "comment": "Swap the top two items."
        },
        {
          "name": "OP_TUCK",
          "code": 125,
          "category": "stack",
          "comment": "Copy the top item below the second."
        },
        {
          "name": "OP_CAT",
          "code": 126,
          "category": "splice",
          "comment": "Concatenate two byte vectors.",
          "disabled": true
